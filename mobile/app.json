{
  "expo": {
    "name": "Reminders App",
    "slug": "reminders-app",
    "version": "1.0.4",
    "scheme": "remindersapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c463d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.remindersapp.mobile",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Reminders App needs access to your calendar to export reminders.",
        "NSRemindersUsageDescription": "Reminders App needs access to create reminders in your calendar.",
        "NSFaceIDUsageDescription": "Reminders App uses Face ID to protect your data.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#15604f"
      },
      "package": "com.remindersapp.mobile",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Reminders App uses Face ID to protect your data."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Reminders App needs access to your calendar to export reminders."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "./plugins/withLocalizedAppName.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53b5aa88-4771-48cf-ac27-f7c25bc34915"
      }
    },
    "owner": "alex_edkiy"
  }
}
