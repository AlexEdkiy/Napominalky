# Базовый URL API.
# Режим прокси (рекомендуется для dev): оставьте VITE_API_URL пустым —
#   клиент использует относительный /api/v1, Vite проксирует /api на backend
#   (см. VITE_PROXY_TARGET). Это снимает проблемы CORS и проброса портов.
# Прямой режим: укажите полный URL backend, напр. http://localhost:8080
VITE_API_URL=

# Цель dev-прокси Vite (куда проксировать /api). По умолчанию nginx из
# docker-compose. Переопределите, если 8080 занят на хосте (напр. http://localhost:18000).
VITE_PROXY_TARGET=http://localhost:8080

VITE_APP_NAME="Reminders App"
