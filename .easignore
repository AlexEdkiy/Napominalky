# .easignore — что НЕ загружать в архив EAS Build.
# ВАЖНО: при наличии .easignore EAS использует ЕГО ВМЕСТО .gitignore,
# поэтому здесь продублировано содержимое корневого .gitignore.
#
# Дополнительно исключены сиблинг-директории монорепо (backend/ Laravel,
# web/ Vue, docs/) — мобильная сборка (mobile/, самодостаточный package-lock)
# их не использует. Это также убирает ошибку EACCES при обходе
# backend/storage/app/private/avatars (runtime-данные под root).

# === Не нужно для мобильной сборки (монорепо) ===
/backend/
/web/
/docs/
/.git/
/deploy/
/.claude/worktrees/

# === Секреты / окружение ===
.env
.env.*
!.env.example
*.pem
backend/docker/certs/*.key
backend/docker/certs/*.crt

# === PHP / Laravel (backend/) ===
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*.php
backend/.phpunit.result.cache
backend/.phpunit.cache/
!backend/storage/framework/cache/data/.gitignore

# === Node / JS (mobile/, web/) ===
node_modules/
mobile/node_modules/
web/node_modules/
web/dist/
web/coverage/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/ios/
mobile/android/
*.tsbuildinfo

# === Drizzle / SQLite артефакты (mobile) ===
mobile/*.db
mobile/*.sqlite

# === Логи / временное ===
*.log
npm-debug.log*
yarn-error.log*

# === ОС / IDE ===
.DS_Store
Thumbs.db
.idea/
*.swp
